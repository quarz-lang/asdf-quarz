#!/bin/sh
# Prints the newest version that is not a prerelease, among those that
# start with the query given (`asdf latest quarz 0.1`), if any.
set -eu
# shellcheck source-path=SCRIPTDIR source=../lib/utils.sh
. "$(dirname "$0")/../lib/utils.sh"

query="${1:-}"
versions=$(list_versions)
printf '%s\n' "$versions" | grep -v -- - | awk -v q="$query" 'q == "" || $0 == q || index($0, q ".") == 1' | tail -n 1
